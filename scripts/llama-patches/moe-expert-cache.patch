diff --git a/src/llama-moecache.h b/src/llama-moecache.h
new file mode 100644
index 0000000..aa81234
--- /dev/null
+++ b/src/llama-moecache.h
@@ -0,0 +1,39 @@
+#pragma once
+
+// GPU-resident LRU cache for MoE expert weights kept in host memory (--n-cpu-moe / -ot), after ggml-org/llama.cpp#27861.
+// Per cached layer, device tensors up_c/gate_c/down_c hold n_slots experts plus one zero slot. For small batches the CPU
+// MUL_MAT_ID skips cached experts (src[3] table) and a device chain computes them; the two partial sums give the full result.
+// Enabled with LLAMA_MOE_EXPERT_CACHE=<slots per layer>, LLAMA_MOE_EXPERT_CACHE_INSERTS=<uploads per layer per step>.
+
+#include <cstdint>
+
+struct llama_model;
+struct ggml_tensor;
+
+// largest ubatch that uses the cache (bigger batches go to the GPU through op offload)
+#define LLAMA_MOE_CACHE_MAX_TOKENS 8
+
+struct llama_moe_cache_layer {
+    int     il      = -1;
+    int32_t n_slots = 0;
+
+    // device slots, ne[2] == n_slots + 1 (last slot all zeros)
+    ggml_tensor * up_c   = nullptr;
+    ggml_tensor * gate_c = nullptr;
+    ggml_tensor * down_c = nullptr;
+
+    // expert id -> slot, or n_slots when not cached; dev I32 [1, n_expert, LLAMA_MOE_CACHE_MAX_TOKENS] (copies), host I32 [1, n_expert]
+    ggml_tensor * dev_table  = nullptr;
+    ggml_tensor * host_table = nullptr;
+};
+
+// only the first call does work
+void llama_moe_cache_init(const llama_model & model);
+
+bool llama_moe_cache_enabled();
+
+// nullptr when the cache is off or this layer is not cached
+const llama_moe_cache_layer * llama_moe_cache_lookup(const ggml_tensor * up_exps);
+
+// apply LRU updates; call only when no graph is running
+void llama_moe_cache_step();
